#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1500  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 100    // 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Config from @caksoylar, defaults in comments

&mmv {
    acceleration-exponent = <1>;      // 1
    time-to-max-speed-ms = <500>;     // 300
    delay-ms = <0>;                   // 0
};

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <40>;      // 300
    delay-ms = <0>;                   // 0
};

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        adjust_layer2 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        c_capswords {
            bindings = <&caps_word>;
            key-positions = <53 56>;
            layers = <0>;
        };

        c_esc {
            bindings = <&kp ESC>;
            key-positions = <14 15>;
            layers = <0 1 2>;
        };

        c_del_bspc {
            bindings = <&bsp_del>;
            key-positions = <20 19>;
            layers = <0 1 2>;
        };

        c_rbkt {
            bindings = <&kp RBKT>;
            key-positions = <30 31>;
            layers = <0 2>;
        };

        c_lbkt {
            bindings = <&kp LBKT>;
            key-positions = <28 29>;
            layers = <0 2>;
        };

        c_sqt {
            bindings = <&kp SQT>;
            key-positions = <19 18>;
            layers = <0 2>;
        };

        c_grave {
            bindings = <&kp GRAVE>;
            key-positions = <16 17>;
            layers = <0 2>;
        };

        c_enter {
            bindings = <&kp RET>;
            key-positions = <16 15>;
            layers = <0 1 2>;
        };

        c_tab {
            bindings = <&kp TAB>;
            key-positions = <20 21>;
            layers = <0 1 2>;
        };

        c_tg_mouse {
            bindings = <&tog 4>;
            key-positions = <37 48>;
            layers = <0 4>;
        };

        c_lpar {
            bindings = <&kp LPAR>;
            key-positions = <28 27>;
            layers = <0 2>;
        };

        c_rpar {
            bindings = <&kp RPAR>;
            key-positions = <31 32>;
            layers = <0 2>;
        };

        c_lbrc {
            bindings = <&kp LBRC>;
            key-positions = <40 41>;
            layers = <0 2>;
        };

        c_rbrc {
            bindings = <&kp RBRC>;
            key-positions = <44 45>;
            layers = <0 2>;
        };

        c_caret {
            bindings = <&kp CARET>;
            key-positions = <17 29>;
            layers = <0 2>;
        };

        c_dllr {
            bindings = <&kp DLLR>;
            key-positions = <18 30>;
            layers = <0 2>;
        };

        c_excl {
            bindings = <&kp EXCL>;
            key-positions = <16 28>;
            layers = <0 2>;
        };

        c_qmark {
            bindings = <&kp QMARK>;
            key-positions = <19 31>;
            layers = <0 2>;
        };

        c_under {
            bindings = <&kp UNDER>;
            key-positions = <40 39>;
            layers = <0 2>;
        };

        c_minus {
            bindings = <&kp MINUS>;
            key-positions = <45 46>;
            layers = <0 2>;
        };

        c_amps {
            bindings = <&kp AMPS>;
            key-positions = <15 27>;
            layers = <0 2>;
        };

        c_pipe {
            bindings = <&kp PIPE>;
            key-positions = <20 32>;
            layers = <0 2>;
        };

        c_equal {
            bindings = <&kp EQUAL>;
            key-positions = <15 28>;
            layers = <0 2>;
        };

        c_plus {
            bindings = <&kp PLUS>;
            key-positions = <20 31>;
            layers = <0 2>;
        };

        c_fslh {
            bindings = <&kp FSLH>;
            key-positions = <27 16>;
            layers = <0 2>;
        };

        c_bslh {
            bindings = <&kp BSLH>;
            key-positions = <19 32>;
            layers = <0 2>;
        };

        c_lt {
            bindings = <&kp LT>;
            key-positions = <27 40>;
            layers = <0 2>;
        };

        c_gt {
            bindings = <&kp GT>;
            key-positions = <32 45>;
            layers = <0 2>;
        };

        c_prcnt {
            bindings = <&kp PRCNT>;
            key-positions = <16 29>;
            layers = <0 2>;
        };

        c_star {
            bindings = <&kp STAR>;
            key-positions = <19 30>;
            layers = <0 2>;
        };

        c_hash {
            bindings = <&kp HASH>;
            key-positions = <39 38>;
            layers = <0 2>;
        };

        c_at {
            bindings = <&kp AT>;
            key-positions = <46 47>;
            layers = <0 2>;
        };
    };

    macros {
        meta_spc: meta_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LMETA>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_wait_time 50>,
                <&macro_release>,
                <&kp LMETA>;

            label = "META_SPC";
        };

        alt_shift: alt_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp LALT>,
                <&macro_wait_time 50>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "ALT_SHIFT";
        };

        m_hold_mod_press_key: m_hold_mod_press_key {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_param_2to1 &kp MACRO_PLACEHOLDER>;

            label = "M_HOLD_MOD_PRESS_KEY";
        };

        la: la {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp 0>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &kp LCTRL &kp LSHFT &kp LALT &kp LWIN>;

            label = "LA";
        };
    };

    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
        };

        hrl: hrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
        };

        osm: osm {
            compatible = "zmk,behavior-sticky-key";
            label = "OSM";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        bsp_del: bsp_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BSP_DEL";
            bindings = <&kp BSPC>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ctrl_tab: ctrl_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "CTRL_TAB";
            bindings = <&m_hold_mod_press_key LCTRL TAB>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        alt_tab: alt_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_TAB";
            bindings = <&m_hold_mod_press_key LALT TAB>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "home mod left";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <165>;
            require-prior-idle-ms = <110>;
            flavor = "balanced";
            hold-trigger-key-positions = <55 56 57 44 45 58 59 43 46 47 49 35 23 11 10 22 34 33 21 9 8 20 32 31 19 7 48 30 18 6>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "home mod right";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <165>;
            require-prior-idle-ms = <110>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <1 0 2 3 4 5 17 29 41 42 54 53 52 51 50 37 36 12 24 25 13 14 15 16 28 40 39 27 26 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            display-name = "qwerty";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&none  &none        &none        &none         &none         &none                           &none      &none         &none         &none        &none           &none
&none  &kp Q        &kp W        &kp E         &kp R         &kp T                           &kp Y      &kp U         &kp I         &kp O        &kp P           &none
&none  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F  &kp G                           &kp H      &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI  &none
&none  &lt 4 Z      &kp X        &kp C         &kp V         &kp B      &kp C_MUTE    &none  &kp N      &kp M         &kp COMMA     &kp DOT      &kp FSLH        &none
                    &none        &none         &mo 2         &kp SPACE  &none         &none  &kp LSHFT  &la 1         &none         &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_BRI_UP C_BRI_DN>;

            label = "qwerty";
        };

        nav {
            display-name = "nav";
            bindings = <
&none  &none      &none      &none        &none        &none                      &none      &none             &none              &none      &none      &none
&none  &none      &none      &kp PG_DN    &kp PG_UP    &none                      &ctrl_tab  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &alt_tab   &kp INS    &none
&none  &osm LGUI  &osm LALT  &osm LCTRL   &osm LSHFT   &none                      &kp LEFT   &kp DOWN          &kp UP             &kp RIGHT  &kp PSCRN  &none
&none  &kp LC(Z)  &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)  &none    &none  &kp HOME   &kp LC(LEFT)      &kp LC(RIGHT)      &kp END    &tog 5     &none
                  &none      &none        &trans       &trans     &none    &none  &trans     &trans            &none              &none
            >;

            label = "navigation";
        };

        number_fn {
            display-name = "number_fn";
            bindings = <
&none  &none         &none         &none          &none          &none                        &none   &none          &none          &none         &none         &none
&none  &kp STAR      &kp N7        &kp N8         &kp N9         &kp PLUS                     &none   &kp F9         &kp F10        &kp F11       &kp F12       &none
&none  &hrm LGUI N0  &hrm LALT N4  &hrm LCTRL N3  &hrm LSHFT N6  &kp MINUS                    &none   &hrm LSHFT F5  &hrm LCTRL F6  &hrm LALT F7  &hrm LGUI F8  &none
&none  &kp FSLH      &kp N1        &kp N2         &kp N3         &kp DOT    &none     &none   &none   &kp F1         &kp F2         &kp F3        &kp F4        &none
                     &none         &none          &trans         &trans     &trans    &trans  &trans  &trans         &none          &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
            label = "number_fn";
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&none  &none         &none         &none       &none         &none                         &none         &none         &none         &none         &none           &none
&none  &kp C_BRI_DN  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp C_BRI_UP                  &bt BT_CLR    &none         &out OUT_TOG  &none         &bt BT_CLR_ALL  &none
&none  &kp C_PREV    &kp LEFT      &kp C_PP    &kp RIGHT     &kp C_NEXT                    &bt BT_SEL 3  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 4    &none
&none  &none         &none         &none       &none         &none         &none    &none  &none         &none         &none         &none         &none           &none
                     &none         &none       &none         &none         &none    &none  &none         &none         &none         &none
            >;
        };

        mouse {
            display-name = "mouse";
            bindings = <
&none  &none  &none     &none      &none      &none                           &none           &none           &none         &none            &none  &none
&none  &none  &none     &none      &none      &none                           &none           &none           &none         &none            &none  &none
&none  &none  &kp LALT  &kp LCTRL  &kp LSHFT  &none                           &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
&none  &none  &none     &none      &none      &none     &none       &none     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
              &none     &none      &mkp MB3   &mkp MB2  &mkp MB1    &mkp MB1  &mkp MB2        &mkp MB3        &none         &none
            >;

            label = "mouse";
        };

        gaming_base {
            display-name = "gaming";
            bindings = <
&kp ESC  &kp N1     &kp N2  &kp N3    &kp N4    &kp N5                                    &kp N6    &kp N7   &kp N8     &kp N9    &kp N0    &kp GRAVE
&kp T    &kp TAB    &kp Q   &kp W     &kp E     &kp R                                     &kp Y     &kp U    &kp I      &kp O     &kp P     &kp LBKT
&kp G    &kp LSHFT  &kp A   &kp S     &kp D     &kp F                                     &kp H     &kp J    &kp K      &kp L     &kp SEMI  &kp APOS
&kp B    &kp LCTRL  &kp Z   &kp X     &kp C     &kp V      &kp C_MUTE    &kp PAUSE_BREAK  &kp N     &kp M    &kp COMMA  &kp DOT   &kp FSLH  &kp RBKT
                    &trans  &kp CAPS  &kp LALT  &kp SPACE  &mo 6         &kp ENTER        &kp BSPC  &kp DEL  &kp EQUAL  &kp BSLH
            >;

            label = "gaming";
            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_BRI_UP C_BRI_DEC>;
        };

        gaming_rise {
            display-name = "g_rise";
            bindings = <
&kp GRAVE  &kp F1   &kp F2    &kp F3    &kp F4  &kp F5                    &kp F6  &kp F7     &kp F8    &kp F9     &kp F10   &kp PSCRN
&kp U      &kp N6   &kp N7    &kp N8    &kp N9  &kp N0                    &none   &trans     &kp UP    &trans     &trans    &kp BSLH
&kp H      &kp J    &kp K     &kp L     &kp I   &kp O                     &trans  &kp LEFT   &kp DOWN  &kp RIGHT  &trans    &trans
&kp COMMA  &kp DOT  &kp Y     &kp N     &kp M   &kp P   &trans    &trans  &trans  &kp LSHFT  &kp LALT  &kp LCTRL  &kp LGUI  &tog 5
                    &kp APOS  &kp FSLH  &trans  &trans  &trans    &trans  &trans  &trans     &trans    &trans
            >;

            label = "g_rise";
        };
    };
};
